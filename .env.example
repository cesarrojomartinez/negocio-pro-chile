# Variables de Entorno y Secretos - Mi Negocio al Día

# Supabase Configuration
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_URL="https://your_project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Proveedor API Gateway (apigateway.cl / SASCO SpA)
# Generar token de API en https://apigateway.cl
APIGATEWAY_TOKEN="your_apigateway_token_here"
APIGATEWAY_BASE_URL="https://apigateway.cl/api/v2/"
REAL_GATEWAY_TEST_ENABLED="true"
REAL_GATEWAY_ALLOWED_COMPANY_IDS=""

# Proveedor SimpleAPI Chile (simpleapi.cl)
SIMPLEAPI_API_KEY="your_simpleapi_key_here"
SIMPLEAPI_BASE_URL="https://api.simpleapi.cl"
